<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>Imageprovider</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</AssemblyVersion>
    <Company>YourName</Company>
    <Product>Imageprovider</Product>
    <Authors>YourName</Authors>
    <Description>Serves images from the media item's local folder, ideal for Posterizarr assets mounted inside the Jellyfin container.</Description>
    <Copyright>Copyright © YourName</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Plugin" Version="10.8.13" />
  </ItemGroup>
</Project>
